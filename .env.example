# Alternative to Docker secrets. Do not commit real credentials.
FUDAN_USERNAME=your-student-or-staff-id
FUDAN_PASSWORD=your-password

# Optional runtime settings.
CANVAS_DOWNLOADER_AUTO_YES=true
CANVAS_TOKEN_PURPOSE=nas-canvas-downloader
CANVAS_FORCE_REFRESH_TOKEN=true
CANVAS_TOKEN_EXPIRES_AFTER_DAYS=1
CANVAS_TARGET_TERM_NAME=2026-2027学年第一学期
CANVAS_COURSE_MANIFEST=.state/2026-fall-courses.json
RUN_INTERVAL_SECONDS=21600

# Example downloader arguments if no command is supplied after "--".
# CANVAS_DOWNLOADER_ARGS=-n -d /downloads
